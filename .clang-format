UseTab: Always
IndentWidth: 8
TabWidth: 8
ColumnLimit: 80
BreakBeforeBraces: Custom
BraceWrapping:
  AfterFunction: true      # function braces on their own line
  AfterControlStatement: false
  AfterStruct: false
AllowShortFunctionsOnASingleLine: None
AllowShortIfStatementsOnASingleLine: false
IndentCaseLabels: false    # case aligned with switch
PointerAlignment: Right    # char *p
ForEachMacros:             # long list: list_for_each_entry, for_each_cpu, ...
